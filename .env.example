# 複製成 .env 後依需要修改
RAG_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
RAG_OLLAMA_URL=http://localhost:11434

# 生成模型：預設為沒有顯示卡也跑得動的 qwen3.5:0.8b（約 1 GB）
# 有 GPU 或記憶體充足時可改 qwen3.5:4b、qwen3.5:9b，答案品質較好
RAG_LLM_MODEL=qwen3.5:0.8b
# Qwen3.5 預設會先「思考」再回答，CPU 上很慢；RAG 問答關掉即可
RAG_LLM_THINK=false
# 多語 embedding，維度 1024
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_DIM=1024

RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5

# 等待 Ollama 回應的秒數；只用 CPU 時第一次載入 7B 模型可能要數分鐘
RAG_REQUEST_TIMEOUT=300
